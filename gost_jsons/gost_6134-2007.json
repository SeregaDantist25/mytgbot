  "formulas": {
    "speed_conversion": {
      "Q": "Q_н = Q · (n_н/n)",
      "H": "H_н = H · (n_н/n)²",
      "P": "P_н = P · (n_н/n)³ · (ρ_н/ρ)",
      "η": "η_н = η",
      "NPSH": "NPSH_н = NPSH · (n_н/n)ˣ (x ≈ 2)"
    },
    "head_calculation": {
      "general": "H = Z₂ - Z₁ + (p₂ - p₁)/(ρ·g) + (U₂² - U₁²)/(2g)",
      "with_differential_manometer": "H = ΔH + (U₂² - U₁²)/(2g)"
    },
    "efficiency": {
      "pump": "η_нас = 0.981·(P_вода·Q·H)/P_нас",
      "aggregate": "η_агр = 0.981·(P_вода·Q·H)/P_агр"
    },
    "npsh": {
      "general": "NPSH = (p₁ + p_атм - p_пара)/(ρ·g) + Z₁ + U₁²/(2g)",
      "below_free_surface": "NPSH = (p_атм - p_пара)/(ρ·g) + Z"
    }
  },
