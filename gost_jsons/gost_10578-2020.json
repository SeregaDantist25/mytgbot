  "formulas": {
    "hourly_feed": {
      "formula": "G = 6·10⁻² · (ΣV·ρ·n) / i",
      "variables": {
        "ΣV": "суммарный объем жидкости, см³",
        "ρ": "плотность жидкости, г/см³",
        "n": "частота вращения вала, мин⁻¹",
        "i": "число циклов"
      }
    },
    "cyclic_feed": {
      "formula": "q_ц = (ΣV / (z·i)) · 10³",
      "variables": {
        "ΣV": "суммарный объем жидкости, см³",
        "z": "число линий высокого давления",
        "i": "число циклов"
      }
    },
    "unevenness": {
      "formula": "δ = 2·(V_max - V_min) / (V_max + V_min) · 100%",
      "variables": {
        "V_max": "максимальная подача по линии, см³",
        "V_min": "минимальная подача по линии, см³"
      }
    }
  },
  "check_algorithm": {
    "purpose": "Алгоритм проверки соответствия топливного насоса требованиям",
    "steps": [
      "1. Определить тип насоса (I/II) и число секций",
      "2. Проверить отклонение подачи (±1.5%)",
      "3. Проверить неравномерность подачи (таблица 2 или 3)",
      "4. Проверить отклонение начала нагнетания (±30')",
      "5. Проверить гидроплотность плунжерных пар (≥15 с при 19.6 МПа)",
      "6. Проверить плавность перемещения плунжера",
      "7. При несоответствии выдать рекомендации"
    ]
  }
