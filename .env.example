# Обязательные параметры
TELEGRAM_BOT_TOKEN=replace_with_test_bot_token
ADMIN_IDS=123456789

# Локальная база; PostgreSQL для разработки не требуется
DATABASE_URL=sqlite:///data/documents.db

# Необязательные AI-функции
GROQ_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
ENGINEER_CODE=

# Локальные пути и журнал
DATA_DIR=data
TEMPLATES_DIR=templates
LOG_LEVEL=INFO
LOG_FILE=bot.log
