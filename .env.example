# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database (SQLite для разработки, PostgreSQL для продакшена)
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///data/documents.db
# PostgreSQL (раскомментировать для prod):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ship_repair

# YandexGPT (Алиса)
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# Paths
DATA_DIR=data
TEMPLATES_DIR=templates
ACTS_DIR=acts

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Rate Limiting
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_FILES=5
RATE_LIMIT_WINDOW=60

# Cache TTL (seconds)
CACHE_TTL=300

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.jpg,.png

# Pagination
PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Security
SECRET_KEY=change_this_in_production
TOKEN_EXPIRE_HOURS=24
